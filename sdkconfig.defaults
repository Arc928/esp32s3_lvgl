CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# FreeRTOS configuration
CONFIG_FREERTOS_HZ=1000

# LVGL configuration
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_DPI_DEF=60
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_LAYER_SIMPLE_BUF_SIZE=48000
CONFIG_LV_DRAW_THREAD_PRIO=4
CONFIG_LV_DRAW_SW_SHADOW_CACHE_SIZE=4
CONFIG_LV_GRADIENT_MAX_STOPS=4
CONFIG_LV_OBJ_STYLE_CACHE=y
# LVGL 9.6 用 LV_COLOR_FORMAT_DEFAULT 取代已废弃的 LV_COLOR_DEPTH
CONFIG_LV_COLOR_FORMAT_RGB565=y
CONFIG_LV_COLOR_DEPTH_UNSET=y
# list / menu / win 在 9.6 废弃、v10 删除，项目没用到
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_WIN=n
# 9.5 的默认值 "assert.h" 在 9.6 已废弃，每个文件都会报警告
CONFIG_LV_ASSERT_HANDLER_INCLUDE=""
# 项目不调用 lv_example_*；9.6 的 observer_5 示例在关闭 lv_win 后无法编译
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_USE_DEMO_BENCHMARK=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FPS_STATS=y
