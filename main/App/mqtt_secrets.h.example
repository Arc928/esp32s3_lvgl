/*
 * MQTT broker 配置模板
 * 复制本文件为 mqtt_secrets.h 并填写实际的 broker 地址和账号。
 * mqtt_secrets.h 已加入 .gitignore，不会被提交。
 *
 * 地址格式：
 *   mqtt://host:1883     明文 TCP
 *   mqtts://host:8883    TLS，用 IDF 自带的根证书包校验服务器（公网云 broker 一般用这个）
 *   ws://host:8083/mqtt  WebSocket；wss:// 同样会校验证书
 * TLS 会多占几十 KB 内部 RAM，换成 mqtts:// 后留意启动日志里的 Free heap。
 */
#pragma once

/* EMQX 公共测试 broker，任何人都能订阅到你的数据，只用来测试 */
#define MQTT_BROKER_URI   "mqtt://broker.emqx.io:1883"

/* 不需要认证就留空 */
#define MQTT_USERNAME     ""
#define MQTT_PASSWORD     ""
